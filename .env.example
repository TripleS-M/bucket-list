PORT=3000
# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Google OAuth Web client ID (free, from Google Cloud Console). Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
# Frontend origin(s) allowed to call the API, comma separated
CLIENT_ORIGIN=http://localhost:5173
DB_PATH=./data/bucketlist.db
